# Local development secrets (copy to .dev.vars — never commit .dev.vars)
APP_PASSWORD=change-me
# Optional: lets you test the Telegram parts locally
# TELEGRAM_BOT_TOKEN=123456:ABC...

# Local testing only: lets login work when the site is shown inside a preview frame.
# Never set this on the real Cloudflare Worker.
# EMBEDDED_PREVIEW=1

# Optional: authorized Crossway key for daily ESV verses (server-side only)
# ESV_API_KEY=
