{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "my-baby-s-website",
  "main": "src/worker.js",
  "compatibility_date": "2025-11-01",
  // Gives the worker Node's fast native Buffer (used to store photos efficiently within free CPU limits).
  "compatibility_flags": ["nodejs_compat"],

  // The website (HTML/CSS/JS) lives in ./public and is served for free as static assets.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/telegram/*"]
  },

  // Free D1 (SQLite) database. On the first `wrangler deploy` Cloudflare creates it
  // automatically — no need to copy a database_id by hand. Tables are created by the app itself.
  "d1_databases": [
    {
      "binding": "DB",
      // Keep this name as-is: it points at the database that holds your real posts.
      "database_name": "caption-studio-db"
    }
  ],

  // Checks for due reminders every 5 minutes (free plan includes cron triggers).
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  "observability": { "enabled": true }

  // Secrets (set them with `npx wrangler secret put NAME` or in the Cloudflare dashboard):
  //   APP_PASSWORD        – the password you type to open the website
  //   TELEGRAM_BOT_TOKEN  – the token @BotFather gives you
  //   ESV_API_KEY         – authorized Crossway key for the daily ESV verse cards
}
